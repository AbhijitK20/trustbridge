# TEMPLATE ONLY. Do not put real secrets here. Copy values into .env or .env.local instead.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI review routing. Keep keys server-side only.
GEMINI_API_KEY=""
AI_REVIEW_PROVIDERS="gemini-3-flash,gemini-3.5-flash-lite,gemini-2.5-flash,local-gateway"
LOCAL_LLM_BASE_URL="http://localhost:8080/v1"
LOCAL_LLM_API_KEY=""

# Payments and notifications (added when those modules are enabled)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_RETURN_URL="http://localhost:3000/onboarding/return"
STRIPE_CONNECT_REFRESH_URL="http://localhost:3000/onboarding/refresh"
PLATFORM_FEE_PERCENT="5"
CRON_SECRET="generate-a-long-random-value"

# Demo mode simulates payment, delivery, and dispute settlement without Stripe or file storage.
# Set to "false" for real integrations.
DEMO_MODE="false"

# Shared rate limiting for multi-instance deployments (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RESEND_API_KEY=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# S3-compatible private evidence storage (Cloudflare R2 or AWS S3)
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET="trustbridge-evidence"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Legal / compliance configuration (replace placeholders before launch)
LEGAL_ENTITY_NAME="TrustBridge Technologies Pvt. Ltd. (placeholder)"
LEGAL_ENTITY_ADDRESS="[Registered address — replace before launch]"
LEGAL_CONTACT_EMAIL="legal@trustbridge.example"
LEGAL_GRIEVANCE_EMAIL="grievance@trustbridge.example"
LEGAL_GRIEVANCE_OFFICER="[Grievance Officer — replace before launch]"
LEGAL_JURISDICTION="India"
PAYMENT_PARTNER_NAME="[Licensed payment/escrow partner — replace before launch]"
LEGAL_TERMS_VERSION="2026-10-27"
LEGAL_PRIVACY_VERSION="2026-10-27"
LEGAL_SELLER_AGREEMENT_VERSION="2026-10-27"
LEGAL_EFFECTIVE_DATE="27 October 2026"
KYC_PROVIDER="manual"

# High-value admin decisions need a second reviewer at or above this amount.
ADMIN_APPROVAL_THRESHOLD_CENTS="1000000"

# WhatsApp Cloud API (optional; demo simulator works without these)
WHATSAPP_VERIFY_TOKEN="trustbridge-demo"
WHATSAPP_APP_SECRET=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Comma-separated Google emails auto-promoted to ADMIN on sign-in.
ADMIN_EMAILS=""
